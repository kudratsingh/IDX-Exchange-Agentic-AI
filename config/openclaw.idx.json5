// OpenClaw config fragment for the IDX assistant (WO-001); keys per OpenClaw docs 2026-09-23.
// scripts/install.sh fills the placeholders into ~/.openclaw/openclaw.idx.json5, then installs
// it as openclaw.json or deep-merges it in (lists replace lists). Never commit the render.
// __REPO__ checkout path; __PYTHON__ venv python with idx_agent; __OWNER_E164__ the one
// WhatsApp number allowed in (IDX_OWNER_E164 in .env). No URLs: the loader cuts at //.
{
  // The idx agent: workspace, visible skills, and the tool allow/deny lists.
  agents: {
    ownership: "explicit",
    defaults: {
      workspace: "~/.openclaw/workspace-idx",
      skipBootstrap: true,
      // Heartbeats are full paid model turns every 30 minutes by default. Off.
      heartbeat: { every: "0m" },
      // The pre-compaction memory flush copies chat facts into workspace Markdown. Off.
      // Set at defaults level; idx is the only agent, so this applies to idx (ADR-0003).
      compaction: { memoryFlush: { enabled: false } },
    },
    entries: {
      idx: {
        workspace: "~/.openclaw/workspace-idx",
        // The final skill set for this agent; nothing else is visible.
        skills: ["health", "property-search"],
        tools: {
          // Only our MCP tools, plus `read` so the model can load SKILL.md bodies.
          // A non-empty allow list blocks everything else; deny always wins.
          allow: ["idx__*", "read"],
          deny: [
            "group:runtime", // exec, process, code_execution
            "write", "edit", "apply_patch",
            "group:web", // web_search, x_search, web_fetch
            "browser",
            "group:ui",
            "group:automation",
            "group:nodes",
            "gateway", "cron", "sessions_spawn", "sessions_send",
          ],
          elevated: { enabled: false },
        },
      },
    },
  },
  // Routes every WhatsApp message to the idx agent.
  bindings: [
    { agentId: "idx", match: { channel: "whatsapp", accountId: "*" } },
  ],
  // How conversations map to sessions.
  session: {
    // One session per sender per channel, never the shared main session.
    dmScope: "per-channel-peer",
  },
  // Gateway process features.
  gateway: {
    // The gateway terminal opens a host shell with the gateway's environment. Off.
    terminal: { enabled: false },
  },
  // Global tool policy: no exec, workspace-only files, no cross-session or cross-chat sends.
  tools: {
    // Show our tool schemas directly instead of hiding them behind tool_search.
    toolSearch: false,
    exec: { security: "deny", ask: "always" },
    fs: { workspaceOnly: true },
    sessions: { visibility: "self" },
    agentToAgent: { enabled: false },
    message: { crossContext: { allowWithinProvider: false, allowAcrossProviders: false } },
  },
  // Where OpenClaw finds skills.
  skills: {
    load: {
      // The repo's skills/ folder is loaded in place; no copies, no symlinks.
      extraDirs: ["__REPO__/skills"],
    },
  },
  // Plugins: memory-core's dreaming job also copies chat facts into workspace Markdown. Off.
  plugins: {
    entries: {
      "memory-core": {
        config: { dreaming: { enabled: false } },
      },
    },
  },
  // The idx MCP server: our Python tools, started as a stdio subprocess from the venv.
  mcp: {
    servers: {
      idx: {
        command: "__PYTHON__",
        args: ["-m", "idx_agent.mcp_server.server"],
        cwd: "__REPO__",
        connectionTimeoutMs: 10000,
        requestTimeoutMs: 30000,
      },
    },
  },
  // WhatsApp: DMs from the owner number only; groups off; chat cannot change config.
  // selfChatMode is deliberately not set here: it must be true while the bot runs on the
  // owner's own phone (no dedicated number yet) and is set once by hand in the live config
  // (openclaw config set channels.whatsapp.selfChatMode true). The merge keeps that value.
  channels: {
    whatsapp: {
      dmPolicy: "allowlist",
      allowFrom: ["__OWNER_E164__"],
      groupPolicy: "disabled",
      configWrites: false,
    },
  },
}
