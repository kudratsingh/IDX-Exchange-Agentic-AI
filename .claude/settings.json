{
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git stash*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guards/guard.py\"",
            "timeout": 10,
            "statusMessage": "guard: checking the command against docs/AGENT_RULES.md"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guards/guard.py\"",
            "timeout": 10,
            "statusMessage": "guard: checking the file path against docs/AGENT_RULES.md"
          }
        ]
      }
    ]
  }
}
