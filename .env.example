# Copy to .env (gitignored). Never commit real values.
# Model provider keys for OpenClaw go in ~/.openclaw/.env, not here: OpenClaw ignores
# provider keys found in a workspace .env. This one is for our own tools only, later.
OPENAI_API_KEY=sk-replace-me

# The one WhatsApp number allowed to talk to the bot (E.164). Read by scripts/install.sh.
IDX_OWNER_E164=+15550100100

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=idx_exchange
# SELECT-only user. Create it in WO-002; never use root here.
MYSQL_USER=idx_reader
MYSQL_PASSWORD=replace-me

# Email: read only by the tool server process, never by the agent runtime.
EMAIL_USER=replace-me@example.com
EMAIL_PASSWORD=replace-me

# Secret for the HMAC that turns a sender id into a session key (WO-006).
# 64 hex characters from a random source; empty means no per-sender state.
# Anything that is not hex of 32+ characters counts as empty: searches still run,
# but nothing is remembered between messages.
IDX_SENDER_KEY=
# Minutes a sender's last search is kept while idle (default 30).
IDX_SESSION_TTL_MINUTES=30
# Most senders remembered at once; past it the oldest is dropped (default 1000).
IDX_SESSION_MAX_ENTRIES=1000

LOG_LEVEL=INFO
